      "query": "My broadband drops every night. My mobile bill has a wrong charge. The TV shows no picture. Roaming data fails abroad. My new SIM will not activate.",
      "turns": [],
      "expect": "rejected",
      "why": "At most four separate issues are accepted.",
      "observed_on_commit": "1a9636f",
      "observed": "accepted",
      "matches_expectation": false
